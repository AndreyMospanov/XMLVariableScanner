<Window x:Class="XmlVariableScanner.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="XML Variable Scanner"
        Width="1040"
        Height="820"
        MinWidth="860"
        MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#123E5D" Padding="28,20">
            <StackPanel>
                <TextBlock Text="XML Variable Scanner" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                <TextBlock Text="Быстрый поиск технических переменных в больших наборах XML"
                           Foreground="#D8E8F3" Margin="0,5,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24">
                <StackPanel x:Name="ConfigurationPanel">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Файлы" Style="{StaticResource SectionTitle}" />

                            <TextBlock Text="Папка с XML" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="InputDirectoryTextBox" Grid.Column="0" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="Выбрать…" Style="{StaticResource SecondaryButton}"
                                        Click="BrowseInputDirectory_Click" />
                            </Grid>

                            <CheckBox x:Name="IncludeSubdirectoriesCheckBox" Content="Включая вложенные папки"
                                      IsChecked="True" Margin="0,12,0,16" />

                            <TextBlock Text="Файл отчёта XLSX" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="OutputPathTextBox" Grid.Column="0" Margin="0,0,8,0" />
                                <Button Grid.Column="1" Content="Сохранить как…" Style="{StaticResource SecondaryButton}"
                                        Click="BrowseOutputPath_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Поиск" Style="{StaticResource SectionTitle}" />

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="Способ чтения" />
                                        <Run Text="  ⓘ" Foreground="{StaticResource PrimaryBrush}"
                                             ToolTip="Быстрый текстовый режим просматривает весь XML, кроме комментариев. XML-режим ищет только в тексте, CDATA и значениях атрибутов." />
                                    </TextBlock>
                                    <ComboBox x:Name="ReadingModeComboBox" SelectedIndex="0">
                                        <ComboBoxItem Tag="FastText" Content="Быстрый текстовый"
                                                      ToolTip="Максимальная скорость. Ищет во всех частях файла, кроме XML-комментариев. Не требует корректной структуры XML." />
                                        <ComboBoxItem Tag="XmlAware" Content="С учётом структуры XML"
                                                      ToolTip="Ищет в тексте, CDATA и значениях атрибутов; пропускает комментарии, имена тегов, декларации и инструкции. Немного медленнее." />
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource FieldLabel}">
                                        <Run Text="Режим маски" />
                                        <Run Text="  ⓘ" Foreground="{StaticResource PrimaryBrush}"
                                             ToolTip="Простой режим покрывает обычные задачи. Профессиональный принимает регулярное выражение .NET." />
                                    </TextBlock>
                                    <ComboBox x:Name="PatternModeComboBox" SelectedIndex="0" SelectionChanged="PatternModeComboBox_SelectionChanged">
                                        <ComboBoxItem Tag="Simple" Content="Простая маска"
                                                      ToolTip="* — любое количество символов переменной; ? — ровно один символ. Пример: $$P_*" />
                                        <ComboBoxItem Tag="RegularExpression" Content="Профессиональная (Regex)"
                                                      ToolTip="Регулярное выражение .NET. Результатом служит всё совпадение либо именованная группа variable. Пример: (?&lt;variable&gt;\$\$P_[A-Z0-9_]+)" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Что искать" />
                                <Run x:Name="SearchHelpRun" Text="  ⓘ" Foreground="{StaticResource PrimaryBrush}"
                                     ToolTip="Простая маска: * заменяет любое количество символов переменной, ? — один символ. Знак % считается обычным символом." />
                            </TextBlock>
                            <TextBox x:Name="SearchPatternTextBox" Text="$$P_*" Margin="0,0,0,14" />

                            <TextBlock Style="{StaticResource FieldLabel}">
                                <Run Text="Исключения — по одному на строку" />
                                <Run x:Name="ExclusionsHelpRun" Text="  ⓘ" Foreground="{StaticResource PrimaryBrush}"
                                     ToolTip="Переменная не попадёт в отчёт, если соответствует хотя бы одной маске. В простом режиме здесь также работают * и ?." />
                            </TextBlock>
                            <TextBox x:Name="ExclusionsTextBox"
                                     Height="92"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="$$P_*_SCHEMA&#x0a;$$P_src_schema&#x0a;$$P_trg_schema" />

                            <CheckBox x:Name="IgnoreCaseCheckBox" Content="Игнорировать регистр"
                                      IsChecked="True" Margin="0,12,0,0"
                                      ToolTip="Включено по умолчанию: Schema, SCHEMA и schema считаются одинаковыми." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Производительность" Style="{StaticResource SectionTitle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Параллельных файлов" Style="{StaticResource FieldLabel}" />
                                    <ComboBox x:Name="ParallelismComboBox" SelectedIndex="2" Width="120" HorizontalAlignment="Left"
                                              ToolTip="Для SSD обычно подходят 4–8. Для HDD лучше 1–2, чтобы избежать лишних перемещений головки.">
                                        <ComboBoxItem Content="1" />
                                        <ComboBoxItem Content="2" />
                                        <ComboBoxItem Content="4" />
                                        <ComboBoxItem Content="8" />
                                        <ComboBoxItem Content="16" />
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Grid.Column="1" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"
                                           VerticalAlignment="Center"
                                           Text="Обработка идёт потоково: XML и итоговая книга не загружаются целиком в память. Для очень длинных физических строк действует лимит ячейки Excel — 32 767 символов." />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Состояние" Style="{StaticResource SectionTitle}" />
                        <ProgressBar x:Name="ProgressBar" Height="12" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="StatusTextBlock" Text="Готово к запуску" Margin="0,10,0,0" />
                        <TextBlock x:Name="DetailsTextBlock" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,14">
            <DockPanel>
                <Button x:Name="OpenOutputFolderButton" Content="Открыть папку отчёта"
                        Style="{StaticResource SecondaryButton}" IsEnabled="False"
                        Click="OpenOutputFolder_Click" DockPanel.Dock="Left" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Отменить" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,10,0" IsEnabled="False" Click="Cancel_Click" />
                    <Button x:Name="StartButton" Content="Начать обработку" Style="{StaticResource PrimaryButton}"
                            Click="Start_Click" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
